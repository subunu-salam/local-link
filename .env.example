# Copy to .env for local dev. On Render, set these in the dashboard (Environment tab).

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the real "Ask Local Link" AI assistant.
# Without it, the assistant still works using the built-in local smart-search fallback.
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: enables live "Import from Google" in Admin → Locations.
# Get a key at https://console.cloud.google.com → enable "Places API (New)".
# With it set, admins can one-click import real shops per area from Google.
GOOGLE_PLACES_API_KEY=

# Where the SQLite database file lives. On Render, point this at a mounted disk
# (e.g. /var/data/local-link.db) to persist data across restarts.
DATABASE_FILE=./data/local-link.db

# Port (Render sets this automatically)
PORT=3000
