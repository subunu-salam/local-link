# Copy to .env for local dev. On Render, set these in the dashboard (Environment tab).

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the real "Ask Local Link" AI assistant.
# Without it, the assistant still works using the built-in local smart-search fallback.
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Enables LIVE real shops/restaurants + photos + ratings pulled from Google by
# location (shown on the customer home "Near You" and inside each category page),
# and one-click "Import from Google" in Admin → Locations.
# Without it, the app shows the built-in Kozhikode demo data instead (still fully works).
# How to get one (free tier available):
#   1. https://console.cloud.google.com  →  create/select a project
#   2. APIs & Services → Library → enable "Places API (New)"
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. (recommended) Restrict the key to the Places API
#   5. Paste it below (local) or into Render → Environment → GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY=

# Where the local SQLite database file lives.
DATABASE_FILE=./data/local-link.db

# --- Persistent database (FREE, keeps data across restarts) ---------------
# On Render's free tier the disk is wiped on every restart, so partner/admin
# changes and orders would reset. Point the app at a free Turso cloud database
# and everything persists (reads stay fast — served from a local copy; writes
# sync to the cloud). Leave these blank to just use the local file above.
# How to get them (100% free):
#   1. https://turso.tech  → sign up (GitHub login)
#   2. Install the CLI:  curl -sSfL https://get.tur.so/install.sh | bash
#      (or use the web dashboard "Create Database")
#   3. turso db create local-link
#   4. turso db show local-link --url        → paste as TURSO_DATABASE_URL
#   5. turso db tokens create local-link     → paste as TURSO_AUTH_TOKEN
#   On Render, add both under Environment. That's it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port (Render sets this automatically)
PORT=3000
